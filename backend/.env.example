# Which LLM provider src.llm.client.get_llm_provider() returns: anthropic | deepseek
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# DeepSeek (https://platform.deepseek.com) — only needed if LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

MAX_UPLOAD_SIZE_MB=2048
QUERY_MAX_ROWS=10000
QUERY_TIMEOUT_SECONDS=30

CORS_ORIGINS=http://localhost:3000

# Supabase (Database + Auth) — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible storage) — R2 > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
